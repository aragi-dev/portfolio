---
import { profile } from "../data/portfolio";
import PixelGlyph from "./PixelGlyph.astro";
import "../styles/hero-pixel.css";
---

<section class="hero hero-pixel" aria-labelledby="hero-title">
  <button type="button" class="sr-only-focusable" data-replay>Reproducir animación de entrada</button>
  <div class="hero-inner">
    <PixelGlyph glyph="aragi" />
    <p class="hero-byline hero-byline-enter" data-disintegrate>by Aldo Matu</p>
    <h1 id="hero-title" class="sr-only">{profile.name}</h1>
  </div>
</section>

<script>
  const replayButton = document.querySelector(
    ".hero-pixel [data-replay]",
  );

  replayButton?.addEventListener("click", () => {
    window.dispatchEvent(new window.CustomEvent("porfolio:replay"));
  });

  const byline = document.querySelector(".hero-pixel .hero-byline");

  const heroSection = document.querySelector(".hero-pixel");
  if (
    byline instanceof HTMLElement &&
    heroSection instanceof HTMLElement &&
    typeof window.innerHeight === "number"
  ) {
    const rect = heroSection.getBoundingClientRect();
    if (rect.bottom <= 0 || rect.top >= window.innerHeight) {
      byline.classList.remove("hero-byline-enter");
    }
  }

  window.addEventListener("porfolio:replay", () => {
    if (!(byline instanceof HTMLElement)) return;
    if (
      typeof window.matchMedia === "function" &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      return;
    }
    byline.classList.remove("hero-byline-enter");
    void byline.offsetWidth;
    byline.classList.add("hero-byline-enter");
  });
</script>
